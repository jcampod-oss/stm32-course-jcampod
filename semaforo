# include <stdint.h>
# include "stm32f411xe.h"
# include "stm32f4xx.h"

//Definicion de variables

volatile uint8_t cambio = 0;
uint8_t parpadeos = 0;

//Encabezado de funciones

void init_GPIO(void); // Congiguracion de los pines del microcontrolador
void init_TIMER(void);// Configuracion del timer para generar interrupciones
void init_EXTI(void); // Configuracion de la interrupcion externa

// Definicion de estados del semaforo
typedef enum{
    Rojo,
    Amarillo,
    VerdeE,
    VerdeP,
} EstadoSemaforo;

EstadoSemaforo estado_actual = Rojo; // Estado inicial del semaforo

// Funcion principal
int main(void){

    init_GPIO();
    init_TIMER();
    init_EXTI();

    while(1){

        if(cambio == 1){
            cambio = 0;
            
            switch(estado_actual){

                case Rojo:
                    GPIOB->ODR |= (GPIO_ODR_OD6); // Encendiendo el led rojo
                    GPIOB->ODR &= ~(GPIO_ODR_OD8); // Apagando el led verde
                    GPIOB->ODR &= ~(GPIO_ODR_OD9); //Apagando el led amarillo
                    estado_actual = VerdeE;
                    break;

                case VerdeE:
                    GPIOB->ODR &= ~(GPIO_ODR_OD6); // Apagando el led rojo
                    GPIOB->ODR |= (GPIO_ODR_OD8); // Encendiendo el led verde
                    GPIOB->ODR &= ~(GPIO_ODR_OD9); //Apagando el led amarillo
                    estado_actual = VerdeP;
                    break;

                case VerdeP:
                    if (parpadeos < 5*2){
                        GPIOB->ODR ^= (GPIO_ODR_OD8); // Cambiando el estado del led verde
                        parpadeos++;
                        estado_actual = VerdeP;
                    }
                    else{
                        estado_actual = Amarillo;
                        parpadeos = 0;
                    }
                    break;
                    
                case Amarillo:
                    GPIOB->ODR &= ~(GPIO_ODR_OD6); // Apagando el led rojo
                    GPIOB->ODR &= ~(GPIO_ODR_OD8); // Apagando el led verde
                    GPIOB->ODR |= (GPIO_ODR_OD9); //Encendiendo el led amarillo
                    estado_actual = Rojo;
                    break;

                default:
                    estado_actual = Rojo;
                    break;
            }

        }
    }
    return 0;
}

// Configuracion de los pines del microcontrolador

void init_GPIO(void){

    // Activando los relojes del microcontrolador
    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN; // Activando el reloj del puerto A
    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN; // Activando el reloj del puerto B
    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOCEN; // Activando el reloj del puerto C

    //Configurando los pines del semaforo 
    GPIOB->MODER |= (GPIO_MODER_MODE6_0 | GPIO_MODER_MODE8_0 | GPIO_MODER_MODE9_0); // Configurando los pines PB6, PB8 y PB9 como salida
    GPIOB->OTYPER &= ~(GPIO_OTYPER_OT6 |GPIO_OTYPER_OT8 | GPIO_OTYPER_OT9); // Congigurando los pines PB6, PB8 y PB9 como push-pull
    GPIOB->OSPEEDR |= (GPIO_OSPEEDR_OSPEED6_1 | GPIO_OSPEEDR_OSPEED8_1 | GPIO_OSPEEDR_OSPEED9_1); // Configurando la velociad de los pines
    GPIOB->ODR &= ~(GPIO_ODR_OD6 | GPIO_ODR_OD8 | GPIO_ODR_OD9); // Iniciando con leds apagados


    //Configurando el led interno del microcontrolador
    GPIOA->MODER |= (GPIO_MODER_MODE5_0); // Configurando el pin PA5 como salida
    GPIOA->OTYPER &= ~(GPIO_OTYPER_OT5); // Configurando el pin PA5 como push-pull
    GPIOA->OSPEEDR |= (GPIO_OSPEEDR_OSPEED5_1); // Configurando la velocidad de salida del pin PA5 rapida
    GPIOA->ODR &= ~(GPIO_ODR_OD5); // Iniciando con el led apagado

    // Configurando el boton de usuario PC13
    GPIOC->MODER &= ~(GPIO_MODER_MODE13); // Configuando el pin PC13 como entrada
    GPIOC->PUPDR &= ~(GPIO_PUPDR_PUPD13); // Configurando el pin C13 sin pull-up ni pull-down
}   

void init_TIMER(void){
    // Activando el reloj del timer 2
    RCC-> APB1ENR |= RCC_APB1ENR_TIM2EN;

    // Configurando el timer 2 
    TIM2->CNT = 0; // Reiniciando el contador
    TIM2->PSC = 16000 - 1; // Confurando el prescaler
    TIM2->ARR = 1000 - 1; // Confiruando el auto-reload
    TIM2->CR1 &= ~(TIM_CR1_DIR); // Configurando el timer aumentando

    TIM2->DIER |= TIM_DIER_UIE; // Habilitando la interrupcion por desbordamiento del contador
    TIM2->CR1 |= TIM_CR1_ARPE; // Habilitando la precarga del auto-reload

    TIM2->SR &= ~(TIM_SR_UIF); // Limpiar la bandera
    NVIC_EnableIRQ(TIM2_IRQn); // Habilitar la interrupcion del timer 2
    TIM2->CR1 |= TIM_CR1_CEN; // Contar
}

void init_EXTI(void){
    // Habilitando el reloj del EXTI
    RCC->APB2ENR |= RCC_APB2ENR_SYSCFGEN;

    SYSCFG->EXTICR[3] |= SYSCFG_EXTICR4_EXTI13_PC; // Configurando la linea 13 para el pin PC13
    
    EXTI->FTSR |= EXTI_FTSR_TR13; // Disparar por flanco de bajada unicamente
    EXTI->PR |= EXTI_PR_PR13; // Ojo se limpia la bandera con 1 NO CON 0
    EXTI->IMR |= EXTI_IMR_IM13; // Habilitar interrupciones de la linea 13

    NVIC_EnableIRQ(EXTI15_10_IRQn); //Habilitar en el NVIC la interrupcion de las lineas 10 a 15
}

// Hacer la interrupcion
void  EXTI15_10_IRQHandler(void){
    if( EXTI->PR & EXTI_PR_PR13){
        EXTI->PR |= EXTI_PR_PR13; // Limpiar la señal de la bandera
        cambio = 1; 
    } 
    
    
}

void TIM2_IRQHandler(void){
    if(TIM2->SR & TIM_SR_UIF){ // verificar si hay interrupcion del timer
        TIM2->SR &= ~(TIM_SR_UIF); // Bajar la bandera

        GPIOA->ODR ^= GPIO_ODR_OD5; // Itercambiar el estado del led del microcontrolador
    }
}
